# ---------------------------------------------------------------------------
# Aari Couture — environment variables
# Copy to `.env.local` and adjust. Every value has a sensible default, so the
# site runs with no .env file at all during development.
# ---------------------------------------------------------------------------

# Boutique WhatsApp number in international format, digits only (no + or spaces).
# Used by the floating action button, product inquiries and order hand-off.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Your site origin — used for canonical metadata and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
