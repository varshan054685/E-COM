# ---------------------------------------------------------------------------
# Aari Couture — environment variables
# Copy to `.env.local` and fill in. The storefront runs without any of these;
# the admin dashboard requires the Supabase pair.
# ---------------------------------------------------------------------------

# --- Boutique ---------------------------------------------------------------
# WhatsApp number, international format, digits only (no + or spaces).
# Drives the floating action button, product inquiries, custom-order requests
# and the cart order hand-off.
NEXT_PUBLIC_WHATSAPP_NUMBER=919488758028

# Site origin — canonical metadata and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required for accounts and /admin) ----------------------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Bypasses Row Level Security — never expose it to the client
# and never prefix it with NEXT_PUBLIC_. Only needed for server-side
# maintenance scripts; the app itself does not require it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Setup --------------------------------------------------------------
# 1. Run supabase/schema.sql in the Supabase SQL editor.
# 2. Run supabase/seed.sql for demo products, orders and categories.
# 3. Sign up once on /register, then promote yourself:
#      update public.profiles set role = 'admin' where email = 'you@example.com';
# 4. Sign in at /admin/login.
